{
  "name": "locmon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight local Linux system monitor, styled with Proof.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SATUNIX/locmon.git" },
  "bugs": { "url": "https://github.com/SATUNIX/locmon/issues" },
  "homepage": "https://github.com/SATUNIX/locmon#readme",
  "engines": { "node": ">=26.13.0 <27" },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --import ./runtime.mjs --test --test-isolation=none test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:smoke": "node --import ./runtime.mjs --test test/server.integration.mjs"
  }
}
