{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locmon:telemetry:v1",
  "title": "LOCMON telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "timestamp_ms", "interval_seconds", "resource", "metrics"],
  "properties": {
    "schema": { "const": "locmon.telemetry/v1" },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "os", "arch", "collector", "version"],
      "properties": {
        "host": { "type": "string" }, "os": { "const": "linux" },
        "arch": { "type": "string" }, "collector": { "const": "locmon" }, "version": { "type": "string" }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "unit", "help", "samples"],
        "properties": {
          "name": { "type": "string", "pattern": "^locmon_[a-zA-Z_][a-zA-Z0-9_]*$" },
          "type": { "enum": ["gauge", "counter"] },
          "unit": { "enum": ["1", "ratio", "bytes", "bytes_per_second", "seconds", "celsius", "rpm", "tokens", "tokens_per_second"] },
          "help": { "type": "string" },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["labels", "value"],
              "properties": {
                "labels": {
                  "type": "object",
                  "required": ["instance"],
                  "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
                  "additionalProperties": { "type": "string" }
                },
                "value": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
